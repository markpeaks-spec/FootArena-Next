<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#050908"><meta name="description" content="FootArena : scores, classements, actualités football, blessures, quiz et fiches joueurs.">
<title>FootArena — Toute l'actu du foot</title>
<style>
:root{--bg:#050908;--panel:#0c1210;--panel2:#101916;--line:#23352b;--green:#9dff00;--green2:#57d600;--muted:#9eafa5;--white:#f5f8f5;--red:#ff5e61;--cyan:#55d9e8}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(ellipse at 75% 0%,#102116 0,transparent 35%),var(--bg);color:var(--white);font:15px/1.5 Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}button,input,select{font:inherit}button{cursor:pointer}.shell{max-width:1500px;margin:auto;display:grid;grid-template-columns:230px minmax(0,1fr);min-height:100vh}.sidebar{border-right:1px solid #1a2a20;padding:25px 16px;display:flex;flex-direction:column;gap:22px;background:#060b08}.brand{font-size:25px;font-weight:950;letter-spacing:-1px}.brand span{color:var(--green)}.tagline{color:var(--muted);font-size:12px;margin-top:-17px}.menu{display:grid;gap:7px}.menu button{border:0;background:transparent;color:#d5ded8;text-align:left;padding:12px;border-radius:10px}.menu button:hover,.menu button.active{background:#142b16;color:var(--green)}.profile{margin-top:auto;border:1px solid var(--line);border-radius:14px;padding:14px}.profile strong{display:block}.profile small{color:var(--muted)}.xpbar{height:6px;background:#243129;border-radius:8px;margin-top:10px;overflow:hidden}.xpbar i{display:block;height:100%;width:0;background:var(--green)}main{min-width:0;padding:20px 24px 30px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:wrap}.tabs{display:flex;gap:6px;flex-wrap:wrap;min-width:0}.tabs button,.pill{background:#101714;border:1px solid #26362c;color:#d8e2db;padding:9px 13px;border-radius:10px}.tabs button.active{background:#1a3212;border-color:#4c921d;color:var(--green)}.status{font-size:12px;color:var(--muted)}.hero{border:1px solid #2c5121;background:radial-gradient(circle at 88% 15%,#26451b 0,transparent 34%),linear-gradient(120deg,#101a12,#0b100d 75%);border-radius:17px;padding:24px 27px;margin-bottom:18px;display:flex;align-items:center;justify-content:space-between;gap:20px}.eyebrow{color:var(--green);font-size:11px;font-weight:800;letter-spacing:1.4px}.hero h1{font-size:clamp(27px,4vw,42px);line-height:1.05;margin:8px 0}.hero p{color:#b6c4ba;margin:0;max-width:650px}.ball{font-size:68px;filter:drop-shadow(0 0 25px #66df2b66)}.layout{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(300px,1fr);gap:16px}.stack{display:grid;gap:16px;align-content:start}.panel{border:1px solid var(--line);background:linear-gradient(145deg,#0e1511,#090e0b);border-radius:14px;padding:18px;min-width:0}.panelhead{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:14px}.panel h2{font-size:18px;margin:0}.muted{color:var(--muted)}.small{font-size:12px}.filters{display:flex;gap:7px;flex-wrap:wrap;margin:12px 0}.filters button{background:#101814;color:#cbd6ce;border:1px solid #28392d;padding:6px 10px;border-radius:20px;font-size:12px}.filters button.active{background:#1b3512;color:var(--green);border-color:#4a8128}.matchlist{display:grid;gap:7px}.match{display:grid;grid-template-columns:78px minmax(0,1fr) 58px minmax(0,1fr);gap:9px;align-items:center;padding:12px;background:#0c1310;border:1px solid #1b2a20;border-radius:10px}.matchtime{font-size:11px;color:var(--muted)}.team{font-size:13px;font-weight:650;overflow-wrap:anywhere}.team:last-child{text-align:right}.score{font-weight:900;font-size:18px;text-align:center;white-space:nowrap}.live{color:var(--green);font-size:10px}.sectiongrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.feature{min-height:150px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,#111b14,#0a100d)}.feature .ico{font-size:25px}.feature h3{margin:8px 0 3px}.feature p{margin:0;color:var(--muted);font-size:12px}.btn{background:var(--green);border:0;color:#10200a;font-weight:850;padding:10px 13px;border-radius:9px}.btn.secondary{background:#1a2b20;color:#eaf3ed;border:1px solid #344a39}.newslist,.injurylist,.tablelist{display:grid;gap:0}.newsitem,.injury,.tableline{padding:12px 0;border-bottom:1px solid #1c2b21}.newsitem:last-child,.injury:last-child,.tableline:last-child{border-bottom:0}.newsitem a{color:var(--white);font-weight:700;text-decoration:none}.newsitem a:hover{color:var(--green)}.source{color:var(--green);font-size:10px;font-weight:800;text-transform:uppercase}.meta{font-size:11px;color:var(--muted);margin-top:4px}.injury{display:grid;grid-template-columns:30px minmax(0,1fr);gap:10px}.injury .ico{font-size:19px}.injury strong{font-size:13px}.tableline{display:grid;grid-template-columns:28px minmax(0,1fr) 38px 38px 42px;gap:7px;font-size:12px;align-items:center}.tableline.header{color:var(--muted);font-size:10px;text-transform:uppercase}.tableline .club{font-weight:650;overflow-wrap:anywhere}.right{text-align:right}.placeholder{color:var(--muted);font-size:13px;padding:12px 0}.field{background:#101814;color:white;border:1px solid #314336;padding:10px;border-radius:9px;width:100%}.playergrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.player{border:1px solid var(--line);background:#0d1510;padding:15px;border-radius:12px}.player .face{font-size:27px}.player h3{font-size:15px;margin:8px 0 2px}.stats{display:flex;gap:18px;margin-top:12px}.stats b{display:block;font-size:20px;color:var(--green)}.answer{display:block;width:100%;text-align:left;padding:12px;margin:8px 0;border-radius:9px;border:1px solid #2a3b30;background:#111b15;color:white}.answer.correct{border-color:var(--green);background:#193019}.answer.wrong{border-color:var(--red);background:#321b1d}.hidden{display:none!important}.page{display:none}.page.active{display:block}.notice{border:1px solid #314532;border-radius:10px;padding:11px 13px;font-size:12px;color:#bdc9bf;background:#0c140e;margin-top:14px}.notice strong{color:var(--green)}footer{padding:25px 0;text-align:center;color:#74847a;font-size:11px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.error{color:#ffc0b7}.loading{color:var(--muted);padding:16px 0}.mobilebrand{display:none}
.quiz-intro h2{font-size:25px;margin:8px 0}.quiz-intro p{max-width:900px}.quiz-level{font-size:12px}.quiz-level.locked{opacity:.45;cursor:not-allowed}.quiz-level.selected{background:#1b3512!important;color:var(--green)!important;border-color:#4a8128!important}.quiz-progress-chip{font-size:11px;padding:5px 8px;border:1px solid var(--line);border-radius:8px}.answer:disabled{cursor:default}.quiz-explanation{border-left:3px solid var(--green);padding-left:12px}.answer:focus-visible,button:focus-visible{outline:2px solid var(--green);outline-offset:2px}@media(max-width:1050px){.shell{grid-template-columns:185px minmax(0,1fr)}main{padding:16px}.layout{grid-template-columns:1fr}.sectiongrid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:680px){.topbar .tabs{width:100%;gap:5px}.topbar .tabs button{padding:7px 9px;font-size:12px}.topbar .status{width:100%}.shell{display:block}.sidebar{position:sticky;top:0;z-index:5;padding:10px 12px;border-right:0;border-bottom:1px solid var(--line)}.brand{font-size:21px}.tagline,.profile{display:none}.menu{display:flex;overflow-x:auto;gap:4px}.menu button{white-space:nowrap;padding:8px 10px;font-size:12px}.menu button:nth-child(n+5){display:none}main{padding:12px}.hero{padding:18px}.ball{display:none}.match{grid-template-columns:56px minmax(0,1fr) 48px minmax(0,1fr);gap:5px;padding:10px 7px}.team{font-size:11px}.sectiongrid,.playergrid{grid-template-columns:1fr}.feature{min-height:110px}.panel{padding:14px}.two{grid-template-columns:1fr}}
</style>
</head>
<body><div class="shell">
<aside class="sidebar"><div class="brand">⚽ Foot<span>Arena</span></div><div class="tagline">Le football, chaque jour.</div><nav class="menu" aria-label="Navigation"><button class="active" data-page="home">⌂ Accueil</button><button data-page="matchesPage">◉ Match Center</button><button data-page="quizPage">♧ Quiz Arena</button><button data-page="newsPage">▤ Le Vestiaire</button><button data-page="playersPage">♙ Player Zone</button><button data-page="tablePage">▦ Classements</button></nav><div class="profile"><small>TON PROFIL</small><strong>Fan de Foot</strong><small id="profileRank">Niveau 1 · Bronze</small><div class="row"><span class="small" id="profileXP">0 XP</span><span>🏆</span></div><div class="xpbar"><i id="xpbar"></i></div></div></aside>
<main><div class="topbar"><nav class="tabs" aria-label="Navigation rapide"><button class="active" data-page="home">⌂ Accueil</button><button data-page="matchesPage">◉ Match Center</button><button data-page="quizPage">♧ Quiz Arena</button><button data-page="newsPage">▤ Le Vestiaire</button><button data-page="playersPage">♙ Player Zone</button><button data-page="tablePage">▦ Classements</button></nav><span class="status" id="updated">Initialisation…</span></div>
<section class="page active" id="home"><div class="hero"><div><div class="eyebrow">TON TERRAIN. TA PASSION.</div><h1>Toute l'actualité foot.<br><span style="color:var(--green)">Une seule arène.</span></h1><p>Scores et classements alimentés par les données de football, actualités sourcées, suivi des blessures, quiz et fiches joueurs.</p></div><div class="ball">⚽</div></div>
<div class="layout"><div class="stack"><section class="panel"><div class="panelhead"><div><h2>🏟️ Match Center</h2><div class="small muted">Résultats et prochaines rencontres</div></div><button class="btn secondary" data-page="matchesPage">Voir tout →</button></div><div class="filters" id="matchFilters"><button class="active" data-comp="ALL">Tous</button><button data-comp="FL1">Ligue 1</button><button data-comp="PL">Premier League</button><button data-comp="PD">Liga</button><button data-comp="CL">Ligue des champions</button></div><div class="matchlist" id="matchList"><div class="loading">Chargement des matchs réels…</div></div><div class="meta">Source : Football-Data.org · horaires affichés en heure de Paris</div></section>
<div class="sectiongrid"><article class="panel feature"><div><div class="ico">🧠</div><h3>Quiz Arena</h3><p>Teste tes connaissances et gagne de l'XP.</p></div><button class="btn" data-page="quizPage">Jouer →</button></article><article class="panel feature"><div><div class="ico">📰</div><h3>Le Vestiaire</h3><p>Actualités, Ballon d'Or, analyses et blessures.</p></div><button class="btn secondary" data-page="newsPage">Lire →</button></article><article class="panel feature"><div><div class="ico">📊</div><h3>Player Zone</h3><p>Compare les statistiques des joueurs.</p></div><button class="btn secondary" data-page="playersPage">Explorer →</button></article></div>
<section class="panel"><div class="panelhead"><h2>📈 Classement — aperçu</h2><button class="btn secondary" data-page="tablePage">Classements →</button></div><div id="miniTable" class="tablelist"><div class="loading">Chargement du classement…</div></div></section></div>
<div class="stack"><section class="panel"><div class="panelhead"><h2>⚡ À la une</h2><button class="btn secondary" data-page="newsPage">Plus →</button></div><div id="topNews" class="newslist"><div class="loading">Récupération des dernières actualités…</div></div></section><section class="panel"><div class="panelhead"><h2>🩹 Blessures & absences</h2><span class="small muted">Dernières infos</span></div><div id="injuryHome" class="injurylist"><div class="loading">Recherche des informations récentes…</div></div><div class="meta">Les indisponibilités sont rapportées par les médias ; vérifie l'article source pour la confirmation et la date de retour.</div></section><section class="panel"><div class="panelhead"><h2>🏆 Ballon d'Or</h2></div><div id="ballonNews"><div class="loading">Recherche des dernières informations sur le Ballon d'Or…</div></div></section><section class="panel"><div class="panelhead"><h2>🔥 Meilleurs buteurs</h2></div><div id="scorers" class="tablelist"><div class="loading">Chargement des buteurs…</div></div></section></div></div>
<div class="notice"><strong>Transparence :</strong> les scores et classements viennent de l'API configurée. Les actualités et blessures sont des articles de presse récents, avec leur média et leur lien. Si une source est indisponible, FootArena l'indique au lieu d'inventer une information.</div></section>
<section class="page" id="matchesPage"><div class="panel"><div class="panelhead"><div><h2>🏟️ Match Center</h2><p class="muted small">Matchs réels, résultats et horaires</p></div><button class="btn secondary" id="refreshMatches">↻ Actualiser</button></div><div class="filters" id="allMatchFilters"><button class="active" data-comp="ALL">Toutes les compétitions</button><button data-comp="FL1">Ligue 1</button><button data-comp="PL">Premier League</button><button data-comp="PD">Liga</button><button data-comp="BL1">Bundesliga</button><button data-comp="SA">Serie A</button><button data-comp="CL">Ligue des champions</button></div><div id="allMatches" class="matchlist"><div class="loading">Chargement…</div></div><div class="meta">La disponibilité des compétitions dépend de ton abonnement Football-Data.org.</div></div></section>
<section class="page" id="newsPage"><div class="panel"><div class="panelhead"><div><h2>📰 Le Vestiaire — actualités</h2><p class="small muted">Articles récents issus de flux d'actualité</p></div><button class="btn secondary" id="refreshNews">↻ Actualiser</button></div><div class="filters" id="newsFilters"><button class="active" data-topic="football">Toute l'actu</button><button data-topic="ballon">Ballon d'Or</button><button data-topic="injuries">Blessures</button><button data-topic="transfers">Transferts</button><button data-topic="ligue1">Ligue 1</button></div><div id="allNews" class="newslist"><div class="loading">Chargement des actualités…</div></div><div class="notice">Les titres et dates sont fournis par les sources liées. Un article peut évoluer après publication ; consulte-le pour les dernières mises à jour.</div></div></section>
<section class="page" id="quizPage">
<div class="panel quiz-intro"><div class="eyebrow">QUIZ ARENA · 120 QUESTIONS</div><h2>Progresse jusqu’au niveau Légende.</h2><p class="muted">12 niveaux, des questions plus exigeantes à chaque étape, des explications après chaque réponse et de l’XP à gagner. Les questions de culture football portent sur des faits stables et vérifiables.</p><div class="filters" id="quizLevelFilters"></div><div class="two"><div><label for="quizCategory" class="small muted">Catégorie</label><select class="field" id="quizCategory"><option value="all">Toutes les catégories</option><option value="rules">Règles du jeu</option><option value="world">Coupe du monde</option><option value="europe">Europe & sélections</option><option value="clubs">Clubs & compétitions</option><option value="legends">Joueurs & histoire</option><option value="women">Football féminin</option></select></div><div><label for="quizLength" class="small muted">Questions par partie</label><select class="field" id="quizLength"><option value="10">10 questions</option><option value="5">5 questions rapides</option></select></div></div><div class="notice" id="quizUnlockNote">Choisis un niveau et lance ton défi. Les niveaux avancés se débloquent avec ton XP.</div><button class="btn" id="startQuiz" style="margin-top:12px">Lancer le défi →</button></div>
<div class="two" style="margin-top:15px"><div class="panel"><div class="panelhead"><h2 id="quizRoundTitle">Prêt à jouer ?</h2><span class="pill" id="qCount">0/10</span></div><div class="xpbar" style="margin:8px 0 18px"><i id="quizProgress" style="width:0%"></i></div><div id="quizCategoryLabel" class="eyebrow">SÉLECTIONNE UN NIVEAU</div><h3 id="question">Chaque bonne réponse te rapproche du niveau suivant.</h3><div id="answers"></div><p id="feedback" aria-live="polite" class="muted"></p><div class="two"><button class="btn secondary" id="hintButton" disabled>💡 Indice</button><button class="btn" id="nextQuestion" disabled>Suivant →</button></div><p id="hintText" class="small muted"></p></div><div class="panel"><div class="eyebrow">TA PROGRESSION</div><h2 id="rankName">🥉 Débutant</h2><div style="font-size:38px;font-weight:900;color:var(--green)" id="totalXP">0 XP</div><p id="xpNext" class="muted">Réponds juste pour gagner de l'XP.</p><div class="xpbar"><i id="bigXPBar"></i></div><div class="stats"><div><b id="quizPlayed">0</b><span class="small muted">parties</span></div><div><b id="quizBest">0%</b><span class="small muted">meilleur score</span></div><div><b id="quizCorrectTotal">0</b><span class="small muted">bonnes réponses</span></div></div><h3>🏅 Tes badges</h3><p id="badges" class="muted">Le premier badge t'attend.</p><h3>📈 Niveaux</h3><div id="quizLevelProgress" class="filters"></div><p class="small muted">Progression enregistrée sur cet appareil uniquement.</p></div></div>
</section>
<section class="page" id="playersPage"><div class="panel"><h2>📊 Player Zone</h2><p class="muted">Recherche des statistiques de joueurs issues de l'API, si disponibles. Les données absentes ne sont pas remplacées par des statistiques inventées.</p><label for="playerSearch">Chercher un joueur ou une joueuse</label><input class="field" id="playerSearch" placeholder="Nom du joueur (ex. Mbappé)"><button class="btn" style="margin-top:10px" id="searchPlayer">Rechercher</button><div id="playerResults" style="margin-top:15px"><div class="placeholder">La recherche dépend des compétitions et données autorisées par l'API.</div></div></div><div class="panel" style="margin-top:15px"><h2>⚔️ Comparateur de joueurs</h2><p class="muted">Les comparaisons nécessitent des statistiques vérifiées pour les deux joueurs. Les sources sont affichées avec les résultats.</p><div class="two"><label>Joueur A<input class="field" id="playerA" placeholder="Premier joueur"></label><label>Joueur B<input class="field" id="playerB" placeholder="Deuxième joueur"></label></div><button class="btn secondary" id="comparePlayers" style="margin-top:10px">Préparer la comparaison</button><div id="compareResult" class="placeholder"></div></div></section>
<section class="page" id="tablePage"><div class="panel"><div class="panelhead"><div><h2>📋 Classements officiels</h2><p class="muted small">Points, matchs et différence de buts</p></div><button class="btn secondary" id="refreshTables">↻ Actualiser</button></div><div class="filters" id="tableFilters"><button class="active" data-comp="FL1">Ligue 1</button><button data-comp="PL">Premier League</button><button data-comp="PD">Liga</button><button data-comp="BL1">Bundesliga</button><button data-comp="SA">Serie A</button></div><div id="fullTable" class="tablelist"><div class="loading">Chargement du classement…</div></div><div class="meta">Source : Football-Data.org. Le classement affiché correspond à la dernière donnée renvoyée par l'API.</div></div></section>
<footer>FootArena · Les données sportives et articles sont fournis par des sources externes. Pas de fausses dépêches, ni de scores simulés.</footer></main></div>
<script src="/quiz-bank.js"></script>
<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const compNames={FL1:'Ligue 1',PL:'Premier League',PD:'Liga',BL1:'Bundesliga',SA:'Serie A',CL:'Ligue des champions',DED:'Eredivisie',PPL:'Primeira Liga'};
let allMatches=[],tables={},allNews=[],newsTopics={football:'football',ballon:'ballon',injuries:'injuries',transfers:'transfers',ligue1:'ligue1'};
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function go(page){$$('.page').forEach(p=>p.classList.toggle('active',p.id===page));$$('[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===page));window.scrollTo({top:0,behavior:'smooth'})}
$$('[data-page]').forEach(b=>b.addEventListener('click',()=>go(b.dataset.page)));
function fmtDate(v){if(!v)return '';let d=new Date(v);return isNaN(d)?'':new Intl.DateTimeFormat('fr-FR',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Paris'}).format(d)}
function scoreText(m){let s=m.score||{};let ft=s.fullTime||{};if(ft.home!=null&&ft.away!=null)return `${ft.home} – ${ft.away}`;let ht=s.halfTime||{};if(ht.home!=null&&ht.away!=null)return `${ht.home} – ${ht.away}`;return '– : –'}
function matchHTML(m){let status=m.status==='IN_PLAY'||m.status==='PAUSED'?'<span class="live">● EN DIRECT</span>':m.status==='FINISHED'?'Terminé':esc(m.status==='TIMED'?'À venir':m.status||'');return `<div class="match"><div class="matchtime">${status}<br>${fmtDate(m.utcDate)}</div><div class="team">${esc(m.homeTeam?.name||'Équipe à confirmer')}</div><div class="score">${scoreText(m)}</div><div class="team">${esc(m.awayTeam?.name||'Équipe à confirmer')}<div class="small muted">${esc(compNames[m.competition?.code]||m.competition?.name||'')}</div></div></div>`}
function renderMatches(target,comp='ALL',limit=10){let arr=allMatches.filter(m=>comp==='ALL'||m.competition?.code===comp).slice(0,limit);$(target).innerHTML=arr.length?arr.map(matchHTML).join(''):'<div class="placeholder">Aucune rencontre disponible dans les données reçues pour ce filtre. Essaie une autre compétition ou actualise plus tard.</div>'}
async function loadSports(){const ids=['matchList','allMatches','miniTable','fullTable','scorers'];try{const r=await fetch('/.netlify/functions/matches');const d=await r.json();if(!r.ok)throw Error(d.error||'API indisponible');allMatches=d.matches||[];tables=d.tables||{};renderMatches('#matchList','ALL',6);renderMatches('#allMatches',window.matchComp||'ALL',80);renderTable('#miniTable',tables.FL1||tables.PL||tables.PD,5);renderTable('#fullTable',tables[window.tableComp||'FL1'],30);renderScorers(d.scorers||[]);$('#updated').textContent='Données sportives · mis à jour '+new Date().toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});}catch(e){ids.forEach(id=>{let el=$('#'+id);if(el)el.innerHTML=`<div class="placeholder error">Données indisponibles : ${esc(e.message)}. Vérifie la fonction Netlify et la variable FOOTBALL_DATA_TOKEN.</div>`});$('#updated').textContent='Connexion aux données indisponible';}}
function renderTable(target,t,limit=20){if(!t?.table?.length){$(target).innerHTML='<div class="placeholder">Classement indisponible pour cette compétition avec les données actuelles de l’API.</div>';return}let rows=t.table.slice(0,limit);$(target).innerHTML='<div class="tableline header"><span>#</span><span>Équipe</span><span class="right">MJ</span><span class="right">Diff.</span><span class="right">Pts</span></div>'+rows.map((x,i)=>`<div class="tableline"><span>${x.position||i+1}</span><span class="club">${esc(x.team?.name||'—')}</span><span class="right">${x.playedGames??'—'}</span><span class="right">${x.goalDifference>0?'+':''}${x.goalDifference??'—'}</span><b class="right">${x.points??'—'}</b></div>`).join('')}
function renderScorers(a){$('#scorers').innerHTML=a.length?a.slice(0,5).map((x,i)=>`<div class="tableline" style="grid-template-columns:22px minmax(0,1fr) 45px"><span>${i+1}</span><span class="club">${esc(x.player?.name||'—')}<div class="meta">${esc(x.team?.name||'')}</div></span><b class="right">${x.goals??'—'} buts</b></div>`).join(''):'<div class="placeholder">Meilleurs buteurs non disponibles avec les données actuelles de l’API.</div>'}
function wireFilters(id,fn){$$(id+' button').forEach(b=>b.addEventListener('click',()=>{$$(id+' button').forEach(x=>x.classList.toggle('active',x===b));fn(b.dataset.comp)}))}
wireFilters('#matchFilters',c=>renderMatches('#matchList',c,8));wireFilters('#allMatchFilters',c=>{window.matchComp=c;renderMatches('#allMatches',c,80)});wireFilters('#tableFilters',c=>{window.tableComp=c;renderTable('#fullTable',tables[c],30)});
$('#refreshMatches').onclick=loadSports;$('#refreshTables').onclick=loadSports;
async function loadNews(topic='football'){let el=topic==='football'?'#topNews':'#allNews';if(topic==='football')$('#allNews').innerHTML='<div class="loading">Chargement…</div>';try{const r=await fetch('/.netlify/functions/news?topic='+encodeURIComponent(topic));const d=await r.json();if(!r.ok)throw Error(d.error||'Flux indisponible');let items=d.items||[];if(topic==='football'){allNews=items;$('#topNews').innerHTML=items.slice(0,4).map(newsHTML).join('')||'<div class="placeholder">Aucun article récent renvoyé par les sources.</div>';$('#allNews').innerHTML=items.map(newsHTML).join('')||'<div class="placeholder">Aucun article récent renvoyé par les sources.</div>';renderNewsExtra();}else{$('#allNews').innerHTML=items.map(newsHTML).join('')||'<div class="placeholder">Aucun article trouvé pour ce thème. Essaie un autre filtre.</div>';if(topic==='injuries')$('#injuryHome').innerHTML=items.slice(0,4).map(injuryHTML).join('')||'<div class="placeholder">Aucune actualité blessure renvoyée. Cela ne signifie pas qu’aucun joueur n’est blessé.</div>';if(topic==='ballon')$('#ballonNews').innerHTML=items.slice(0,3).map(newsHTML).join('')||'<div class="placeholder">Aucune nouvelle récente sur le Ballon d’Or n’a été renvoyée.</div>';}}catch(e){let msg=`<div class="placeholder error">Actualités indisponibles : ${esc(e.message)}. Les articles ne sont pas inventés.</div>`;$(el).innerHTML=msg;if(topic==='football'){$('#allNews').innerHTML=msg;$('#injuryHome').innerHTML=msg;$('#ballonNews').innerHTML=msg}}}
function newsHTML(n){return `<article class="newsitem"><div class="source">${esc(n.source||'Source externe')} · ${esc(n.topicLabel||'Football')}</div><a href="${esc(n.link||'#')}" target="_blank" rel="noopener noreferrer">${esc(n.title||'Article')}</a><div class="meta">${esc(n.dateLabel||'Date non fournie')} ${n.description?` · ${esc(n.description).slice(0,190)}`:''}</div></article>`}
function injuryHTML(n){return `<div class="injury"><div class="ico">🩹</div><div><strong>${esc(n.title||'Information blessure')}</strong><div class="meta">${esc(n.source||'Source externe')} · ${esc(n.dateLabel||'')}</div><a href="${esc(n.link||'#')}" target="_blank" rel="noopener noreferrer" class="small" style="color:var(--green)">Lire la source ↗</a></div></div>`}
async function renderNewsExtra(){loadNews('injuries');loadNews('ballon')}
$('#refreshNews').onclick=()=>loadNews('football');wireFilters('#newsFilters',()=>{});$$('#newsFilters button').forEach(b=>b.onclick=()=>{$$('#newsFilters button').forEach(x=>x.classList.toggle('active',x===b));loadNews(b.dataset.topic)});
// Quiz Arena is powered by a local bank of 120 checked, stable football facts.
const questions=window.FOOTARENA_QUIZ_BANK||[];
const levelThresholds=[0,250,600,1000,1500,2100,2800,3600,4500,5500,6600,7800];
const levelNames=['Débutant','Supporter','Amateur','Confirmé','Tacticien','Expert','Stratège','Champion','Maître','Élite','Légende','Hall of Fame'];
let xp=+(localStorage.getItem('fa-xp')||0), quizState={played:0,best:0,correctTotal:0,...JSON.parse(localStorage.getItem('fa-quiz-stats')||'{}')};
let selectedLevel=1,round=[],qi=0,correct=0,answered=false,roundXP=0,hintShown=false;
const xpForQuestion=level=>20+level*5;
function unlockedLevel(){let n=1;levelThresholds.forEach((v,i)=>{if(xp>=v)n=i+1});return Math.min(12,n)}
function updateXP(){let level=unlockedLevel(),next=levelThresholds[level]??levelThresholds[11]+1500,prev=levelThresholds[level-1]||0;$('#profileXP').textContent=xp+' XP';$('#profileRank').textContent='Niveau '+level+' · '+levelNames[level-1];$('#xpbar').style.width=Math.min(100,(xp-prev)/Math.max(1,next-prev)*100)+'%';$('#totalXP').textContent=xp+' XP';$('#rankName').textContent='Niveau '+level+' · '+levelNames[level-1];$('#xpNext').textContent=level>=12?'Niveau maximum atteint !':(next-xp)+' XP avant le niveau '+(level+1);$('#bigXPBar').style.width=Math.min(100,(xp-prev)/Math.max(1,next-prev)*100)+'%';$('#quizPlayed').textContent=quizState.played;$('#quizBest').textContent=quizState.best+'%';$('#quizCorrectTotal').textContent=quizState.correctTotal;let badges=[];if(quizState.played>=1)badges.push('⚽ Première partie');if(quizState.best>=70)badges.push('🎯 Tireur de précision');if(quizState.best===100)badges.push('🏆 Sans-faute');if(level>=5)badges.push('🧠 Tacticien');if(level>=9)badges.push('👑 Légende');$('#badges').textContent=badges.join(' · ')||'Le premier badge t’attend.';renderLevelButtons()}
function renderLevelButtons(){let unlocked=unlockedLevel();$('#quizLevelFilters').innerHTML=levelNames.map((name,i)=>{let n=i+1,lock=n>unlocked;return `<button class="quiz-level ${n===selectedLevel?'selected':''} ${lock?'locked':''}" data-level="${n}" ${lock?'disabled':''}>${lock?'🔒':'⚽'} Niv. ${n} · ${name}</button>`}).join('');$('#quizLevelProgress').innerHTML=levelNames.map((name,i)=>`<span class="quiz-progress-chip">${i+1<=unlocked?'🟢':'🔒'} ${i+1}</span>`).join('');$$('#quizLevelFilters [data-level]').forEach(b=>b.onclick=()=>{selectedLevel=+b.dataset.level;renderLevelButtons();updateUnlockNote()});updateUnlockNote()}
function updateUnlockNote(){let need=levelThresholds[selectedLevel-1]||0;$('#quizUnlockNote').textContent=selectedLevel>unlockedLevel()?'Niveau verrouillé : gagne encore de l’XP pour le débloquer.':'Niveau '+selectedLevel+' — '+levelNames[selectedLevel-1]+'. '+(need?`Seuil de déblocage : ${need} XP.`:'Le premier défi est accessible.')}
function shuffle(a){let b=[...a];for(let i=b.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[b[i],b[j]]=[b[j],b[i]]}return b}
function startQuiz(){if(selectedLevel>unlockedLevel()){updateUnlockNote();return}let cat=$('#quizCategory').value;let pool=questions.filter(q=>q.level===selectedLevel&&(cat==='all'||q.category===cat));if(!pool.length){$('#question').textContent='Aucune question dans cette catégorie pour ce niveau.';return}round=shuffle(pool).slice(0,+$('#quizLength').value);qi=0;correct=0;roundXP=0;$('#quizRoundTitle').textContent='Niveau '+selectedLevel+' · '+levelNames[selectedLevel-1];$('#startQuiz').textContent='Recommencer ce défi';drawQuestion()}
function drawQuestion(){answered=false;hintShown=false;let q=round[qi];if(!q)return;$('#qCount').textContent=`Question ${qi+1}/${round.length}`;$('#quizProgress').style.width=(qi/round.length*100)+'%';$('#quizCategoryLabel').textContent=q.categoryLabel+' · '+xpForQuestion(selectedLevel)+' XP';$('#question').textContent=q.question;$('#feedback').textContent='';$('#hintText').textContent='';$('#hintButton').disabled=false;$('#hintButton').textContent='💡 Indice';$('#nextQuestion').disabled=true;$('#nextQuestion').textContent=qi===round.length-1?'Terminer le défi →':'Question suivante →';$('#answers').innerHTML=q.options.map((a,i)=>`<button class="answer" data-answer="${i}">${esc(a)}</button>`).join('');$$('[data-answer]').forEach(b=>b.onclick=()=>answerQuestion(+b.dataset.answer));}
function answerQuestion(index){if(answered)return;answered=true;let q=round[qi],ok=index===q.answer;if(ok){correct++;roundXP+=xpForQuestion(selectedLevel)}$$('[data-answer]').forEach((b,i)=>{b.disabled=true;if(i===q.answer)b.classList.add('correct');else if(i===index)b.classList.add('wrong')});$('#feedback').innerHTML=`<div class="quiz-explanation"><strong>${ok?'Bonne réponse ! +'+xpForQuestion(selectedLevel)+' XP':'Pas cette fois.'}</strong><br>${esc(q.explanation)}</div>`;$('#nextQuestion').disabled=false;$('#hintButton').disabled=true;$('#quizProgress').style.width=((qi+1)/round.length*100)+'%'}
$('#hintButton').onclick=()=>{if(!answered&&!hintShown){hintShown=true;$('#hintText').textContent='Indice : '+round[qi].hint;$('#hintButton').textContent='Indice affiché';$('#hintButton').disabled=true}};
$('#startQuiz').onclick=startQuiz;
function finishRound(){xp+=roundXP;quizState.played++;quizState.correctTotal+=correct;quizState.best=Math.max(quizState.best,Math.round(correct/round.length*100));localStorage.setItem('fa-xp',String(xp));localStorage.setItem('fa-quiz-stats',JSON.stringify(quizState));updateXP();$('#question').textContent=`Défi terminé : ${correct}/${round.length}`;$('#answers').innerHTML='';$('#feedback').innerHTML=`<div class="quiz-explanation"><strong>+${roundXP} XP gagnés !</strong><br>${Math.round(correct/round.length*100)} % de réussite. ${correct===round.length?'Sans-faute, incroyable !':correct>=round.length*.7?'Très bon score, continue comme ça.':'Entraîne-toi et retente le défi.'}</div>`;$('#qCount').textContent='Terminé';$('#quizProgress').style.width='100%';$('#hintButton').disabled=true;$('#nextQuestion').textContent='Rejouer ce niveau';$('#nextQuestion').disabled=false;$('#nextQuestion').onclick=()=>{renderLevelButtons();startQuiz();$('#nextQuestion').onclick=advanceQuiz;};}
function advanceQuiz(){if(!answered)return;if(qi<round.length-1){qi++;drawQuestion()}else finishRound()}
$('#nextQuestion').onclick=advanceQuiz;
updateXP();
$('#searchPlayer').onclick=()=>{$('#playerResults').innerHTML='<div class="placeholder">Les statistiques individuelles ne sont pas incluses dans toutes les offres Football-Data.org. Consulte les actualités et les sources officielles pour confirmer les données du joueur.</div>';};$('#comparePlayers').onclick=()=>{$('#compareResult').textContent='Aucune comparaison affichée : les statistiques vérifiées des deux joueurs doivent être disponibles avant de les comparer.'};
loadSports();loadNews('football');loadNews('injuries');loadNews('ballon');setInterval(loadSports,5*60*1000);setInterval(()=>loadNews('football'),10*60*1000);
</script></body></html>
